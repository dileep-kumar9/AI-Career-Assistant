# ---------------------------------------------------------------------------
# AI Career Assistant — configuration. Copy to .env and fill in.
# Never commit .env or real keys (it is git-ignored). Keys are read by the
# server only, except the VITE_* values, which are public web identifiers.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=8790
# Loopback by default: the API can drive a browser and submit applications.
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# firestore  = Cloud Firestore in the Firebase project below (recommended; same
#              project as resume-creator-ai — this app's collections start with
#              FIRESTORE_PREFIX so the two apps never see each other's data)
# (empty)    = local SQLite file in DATA_DIR
# postgres://user:pass@host:5432/db also works (set PGSSL=true for TLS)
DATABASE_URL=firestore
FIRESTORE_PREFIX=aca_
# Local files: SQLite DB, uploads, generated PDFs, the automation browser profile
DATA_DIR=./data

# --- Firebase (sign-in + Firestore) -----------------------------------------
# Server (secret): Firebase console → Project settings → Service accounts → Generate new private key.
# With FIREBASE_PROJECT_ID set, signing in is required.
# Without Firebase the app runs in single-user local mode (only on HOST=127.0.0.1).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# One line, with \n for line breaks, including the BEGIN/END lines.
FIREBASE_PRIVATE_KEY=

# Browser (public identifiers): Project settings → General → Your apps → Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- AI providers -----------------------------------------------------------
# Tried in this order; missing keys are skipped and failures fall through.
# With no keys, every feature still works with clearly-labelled rule-based fallbacks.
AI_PROVIDER_ORDER=gemini,groq,mistral,anthropic
AI_TIMEOUT_MS=120000
# Google Gemini (free tier): https://aistudio.google.com/apikey — also used for RAG embeddings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Mistral (free "Experiment" plan): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Claude (paid, optional). Put "anthropic" first in AI_PROVIDER_ORDER to prefer it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium
# ANTHROPIC_FALLBACKS=false

# --- Automation (job search + applying) --------------------------------------
# Browser used for job sites: chrome (your installed Google Chrome), msedge or chromium.
BROWSER_CHANNEL=chrome
# Profile where you log in to LinkedIn / Naukri / Indeed once (default: DATA_DIR/browser-profile).
# BROWSER_PROFILE_DIR=
# Keep false: you need to see the browser to solve CAPTCHAs and log in.
BROWSER_HEADLESS=false
# true = fill forms but never press Submit anywhere (global safety switch).
AUTOMATION_DRY_RUN=false

# --- ATS scoring ------------------------------------------------------------
# ATS_WEIGHTS={"keywords":30,"requiredSkills":25,"experience":20,"structure":15,"education":10}
ATS_SEMANTIC_ANALYSIS=true

# --- Limits -----------------------------------------------------------------
MAX_UPLOAD_MB=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL=600
RATE_LIMIT_AI=30
