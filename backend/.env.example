APP_NAME=AI Career & Job Application Assistant
APP_VERSION=1.0.0
ENVIRONMENT=development

# SQLite for local dev; swap for Postgres in production, e.g.:
# DATABASE_URL=postgresql://career_user:career_pass@db:5432/career_assistant
DATABASE_URL=sqlite:///./career_assistant.db

# Groq (https://console.groq.com) -- free, no credit card required, very fast
# (Llama 3.3 70B on their LPU hardware). Get a key at console.groq.com/keys.
# Without it, AI endpoints still work but return clearly-labeled heuristic
# fallback results instead of live model output.
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1024

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Sign-In (optional). Leave blank to use plain email/name sign-in instead.
GOOGLE_CLIENT_ID=
